# Copiez ce fichier en ".env" puis adaptez les valeurs. Ne commitez jamais ".env".

# --- Serveur (garder 127.0.0.1 : l'appli est prévue pour un usage local uniquement) ---
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# --- Calendrier Campass ---
# URL d'abonnement ICS (contient souvent un jeton privé : ne la partagez pas).
# Vous pouvez aussi la saisir dans l'interface (page "Synchronisation") ou uploader un .ics.
ICS_URL=
TIMEZONE=Europe/Paris
# Rafraîchissement automatique en minutes (0 = désactivé, manuel uniquement)
AUTO_REFRESH_MINUTES=60
# Fenêtre d'import autour d'aujourd'hui (jours)
SYNC_PAST_DAYS=30
SYNC_FUTURE_DAYS=150
# Regroupement des occurrences : "subject" (toute la matière) ou "subject_kind" (matière + CM/TD/TP)
GROUP_BY=subject

# Regex optionnelle pour adapter l'analyse du titre Campass (groupes nommés : subject, kind).
# Exemple pour "CM - Mathématiques" :  ^(?P<kind>CM|TD|TP)\s*-\s*(?P<subject>.+)$
SUMMARY_REGEX=
# Événements à ignorer (regex insensible à la casse, appliquée au titre)
IGNORE_REGEX=(férié|vacances|fermeture)

# --- Planification ---
DAY_START=08:00
DAY_END=21:00
# Heure à partir de laquelle on préfère placer les révisions (après les cours)
PREFERRED_START=18:00
# Capacité de travail quotidienne (minutes) pour la jauge de charge
DAILY_CAPACITY_MINUTES=180
# Nombre de jours passés conservés dans l'agenda de révision
HISTORY_DAYS=7

# --- Sécurité ---
DB_PATH=data/revisions.db
# Autoriser les URL ICS pointant vers des IP privées (déconseillé : protège contre le SSRF)
ALLOW_PRIVATE_ICS_HOSTS=0
