# Copiez ce fichier en ".env" puis adaptez les valeurs. Ne commitez jamais ".env".
# En ligne (Render, PythonAnywhere…), définissez ces valeurs comme variables d'environnement.

# --- Serveur (en local : 127.0.0.1 ; l'hébergeur lance gunicorn lui-même) ---
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# --- Sécurité des comptes ---
# Clé qui signe les cookies de session. OBLIGATOIRE en ligne. Pour en générer une :
#   python -c "import secrets; print(secrets.token_hex(32))"
# (en local, si vide, une clé est créée automatiquement dans data/.secret_key)
SECRET_KEY=
# 1 en ligne (HTTPS) : le cookie de session n'est envoyé qu'en HTTPS. Laisser 0 en local (http).
SESSION_COOKIE_SECURE=0
# 1 derrière le proxy d'un hébergeur (Render, Railway…) pour lire la vraie IP et le https.
TRUST_PROXY=0
SESSION_DAYS=14
# Création de comptes. En ligne, définissez un INVITE_CODE (ou ALLOW_REGISTRATION=0 une fois
# vos comptes créés) pour que personne d'autre ne puisse s'inscrire.
ALLOW_REGISTRATION=1
INVITE_CODE=
# Limitation des tentatives de connexion : N échecs par fenêtre (identifiant + adresse IP)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# --- Données ---
# Base SQLite. Sur un hébergeur, placez-la sur un disque PERSISTANT (ex. /var/data/revisions.db).
DB_PATH=data/revisions.db

# --- Calendrier ---
# Le lien ICS (Geode / Campass) est saisi par chaque utilisateur dans la page « Synchronisation ».
TIMEZONE=Europe/Paris
# Rafraîchissement automatique en minutes (0 = désactivé, manuel uniquement)
AUTO_REFRESH_MINUTES=60
# Fenêtre d'import autour d'aujourd'hui (jours)
SYNC_PAST_DAYS=30
SYNC_FUTURE_DAYS=150
# Regroupement des occurrences : "subject" (toute la matière) ou "subject_kind" (matière + CM/TD/TP)
GROUP_BY=subject

# Regex optionnelle pour adapter l'analyse du titre (groupes nommés : subject, kind).
SUMMARY_REGEX=
# Événements à ignorer (regex insensible à la casse, appliquée au titre)
IGNORE_REGEX=(férié|vacances|fermeture)

# --- Planification ---
DAY_START=08:00
DAY_END=21:00
# Heure à partir de laquelle on préfère placer les révisions (après les cours)
PREFERRED_START=18:00
# Capacité de travail quotidienne (minutes) pour la jauge de charge
DAILY_CAPACITY_MINUTES=180
# Nombre de jours passés conservés dans l'agenda de révision
HISTORY_DAYS=7
# Créneaux de rattrapage au maximum ajoutés par cycle quand une matière a du retard
EXTRA_CAP_PER_CYCLE=2

# Autoriser les URL ICS pointant vers des IP privées (déconseillé : protège contre le SSRF)
ALLOW_PRIVATE_ICS_HOSTS=0
